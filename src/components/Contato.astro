---
import Icone from './Icone.astro';
import { perfil } from '../data/conteudo';
import { textosDaInterface, traduzir, type Idioma } from '../i18n/ui';

interface Props {
  idioma: Idioma;
}

const { idioma } = Astro.props;
const ui = textosDaInterface(idioma);
---

<section class="secao contato" id={ui('id.contato')} aria-labelledby="titulo-contato">
  <h2 class="rotulo" id="titulo-contato">{ui('contato.titulo')}</h2>
  <a class="contato-email" href={`mailto:${perfil.emailPrincipal}`}>{perfil.emailPrincipal}</a>
  <p class="contato-extra">
    <span>{ui('contato.ou')} <a href={`mailto:${perfil.emailSecundario}`}>{perfil.emailSecundario}</a></span>
    <span><Icone nome="local" tamanho={15} />{traduzir(perfil.local, idioma)}</span>
  </p>
</section>
