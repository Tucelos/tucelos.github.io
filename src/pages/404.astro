---
// Página exibida pelo GitHub Pages para endereços que não existem.
import Base from '../layouts/Base.astro';
import { textosDaInterface } from '../i18n/ui';

const pt = textosDaInterface('pt-br');
const en = textosDaInterface('en');
---

<Base idioma="pt-br" titulo={`${pt('erro.titulo')} · Tuigg Barcelos`} semIndexar>
  <main id="conteudo" class="secao erro">
    <p class="rotulo">404</p>
    <h1>{pt('erro.titulo')}</h1>
    <p>{pt('erro.texto')} <a href="/">{pt('erro.voltar')}</a>.</p>
    <p lang="en">{en('erro.texto')} <a href="/en/">{en('erro.voltar')}</a>.</p>
  </main>
</Base>

<style>
  .erro {
    min-height: 80vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .erro h1 {
    font-size: clamp(40px, 6vw, 72px);
    letter-spacing: -0.04em;
    line-height: 1;
    margin: 0 0 24px;
  }

  .erro p:not(.rotulo) {
    color: var(--suave);
    margin: 0 0 8px;
  }

  .erro a {
    color: var(--acento);
  }
</style>
